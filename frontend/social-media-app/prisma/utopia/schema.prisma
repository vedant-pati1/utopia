generator utopia_client {
  provider = "prisma-client-js"
  output   = "../../prisma/utopia"
}

datasource db {
  provider = "postgresql"
  url      = env("UTOPIA_DATABASE_URL")
  schemas  = ["utopia"]
}

model UtopiaUser {
  id           Int     @id @default(autoincrement())
  name         String?
  username     String? @unique @db.VarChar(50)
  auth_user_id String  @unique @db.VarChar(50)
  email        String  @unique
  image        String?

  followers FollowAssociation[] @relation("UserFollowers")
  following FollowAssociation[] @relation("UserFollowing")

  @@map("users")
  @@schema("utopia")
}

model FollowAssociation {
  user_id     Int
  follower_id Int
  followedAt  DateTime @default(now())

  user     UtopiaUser @relation("UserFollowers", fields: [user_id], references: [id], onDelete: Cascade)
  follower UtopiaUser @relation("UserFollowing", fields: [follower_id], references: [id], onDelete: Cascade)

  @@id([user_id, follower_id])
  @@map("follow_association")
  @@schema("utopia")
}

model Posts {
  id         Int    @id @default(autoincrement())
  user_id    Int
  content    String @db.VarChar(500)
  image      Bytes?
  created_at String @db.VarChar(50)

  @@map("posts")
  @@schema("utopia")
}

model Messages {
  message_id Int      @id @default(autoincrement())
  user_id    Int
  created_at DateTime @default(now())
  content    String   @db.Text

  @@map("messages")
  @@schema("utopia")
}
